{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/ops/cron/prices-refresh",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/ops/cron/snapshots-run",
      "schedule": "0 11 * * *"
    }
  ]
}
