# Copy to .env.local for local development.
#
# Trackr Workspace talks to the SAME FastAPI backend as Trackr+ -- one API, one
# database, one set of accounts and investor records. There is no Workspace backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# There is deliberately no NEXT_PUBLIC_TRACKR_PRODUCT and no Workspace feature flag.
# Product identity comes from which application you are running; product ACCESS comes
# from the server, via GET /auth/capabilities, and is granted only by the audited
# operator command `python -m app.db.grant_capability`. An environment variable that
# could turn Workspace on would be a client-side authorization check, which is not one.
