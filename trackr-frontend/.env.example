# Copy to .env.local for local development.

# FastAPI backend base URL (no /v1 prefix -- app/main.py mounts routers at the root).
# `make dev` (repo root) runs uvicorn on the default host/port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# Mirrors trackr-backend/.env.example's INGEST_DOMAIN. Every real forwarding address
# always comes from the backend's account response (AccountOut.forwarding_addresses) --
# this is only used for the illustrative "e.g. c001-zerodha-contractnote@..." example
# shown on Settings before any account has been added. Safe to leave unset; the example
# is simply omitted.
NEXT_PUBLIC_INGEST_DOMAIN=
